{
  "title": "Correction Remediation Plan Handoff",
  "task": "D236",
  "status": "beta",
  "backend_commit": "5d44915",
  "principle": "Correction remediation must be explicit, reversible and approval-gated. Public UI may request and display plan drafts, but it must not execute hidden mutations.",
  "public_repo_rule": "GitHub Pages may store remediation draft metadata and local approval notes only; it must never store raw prompts, raw responses, transcripts, provider keys, session tokens or document text.",
  "backend_route": {
    "method": "POST",
    "path": "/context/corrections/remediation-plans",
    "auth": "protected-backend-auth",
    "status": "beta",
    "purpose": "Create non-executing remediation plan drafts for owner-scoped correction review items."
  },
  "frontend_module": "./apps/mimir-chat-portal/context-correction-sync.js",
  "local_storage": {
    "review_state": "mimir-context-correction-review-v1:{workspace}",
    "plan_state": "mimir-context-correction-remediation-plan-v1:{workspace}",
    "metadata_only": true
  },
  "ui_contract": {
    "panel": ".context-correction-plan-panel",
    "actions": ".context-correction-plan-actions",
    "steps": ".context-correction-plan-steps",
    "create_selector": "[data-correction-plan=\"create\"]",
    "approve_selector": "[data-correction-plan=\"approve\"]",
    "defer_selector": "[data-correction-plan=\"defer\"]"
  },
  "plan_policy": {
    "execution_allowed": false,
    "destructive_execution_allowed": false,
    "automatic_mutation_allowed": false,
    "public_frontend_authority": false,
    "no_paid_routes_started": true,
    "raw_prompt_stored": false,
    "raw_response_stored": false,
    "provider_secrets_stored": false
  },
  "safe_steps": [
    "Inspect receipt metadata",
    "Review memory scope and expiry",
    "Review knowledge source health",
    "Plan knowledge collection split",
    "Tune context source policy",
    "Prepare undo follow-through"
  ],
  "blocked_fields": [
    "prompt",
    "raw_prompt",
    "response",
    "raw_response",
    "messages",
    "transcript",
    "api_key",
    "access_token",
    "refresh_token",
    "secret",
    "document_text"
  ],
  "scenarios": [
    {
      "id": "plan-single-review-item",
      "status": "ready",
      "expected": "Users can create a draft plan from one protected review item.",
      "selector": "[data-correction-plan=\"create\"][data-correction-id]",
      "no_paid_routes_started": true,
      "provider_secrets_stored": false,
      "raw_prompt_stored": false,
      "raw_response_stored": false,
      "execution_allowed": false
    },
    {
      "id": "plan-memory",
      "status": "ready",
      "expected": "Users can ask for a memory remediation plan without executing memory edits.",
      "selector": "[data-correction-plan=\"create\"][data-target-filter=\"memory\"]",
      "no_paid_routes_started": true,
      "provider_secrets_stored": false,
      "raw_prompt_stored": false,
      "raw_response_stored": false,
      "execution_allowed": false
    },
    {
      "id": "plan-knowledge",
      "status": "ready",
      "expected": "Users can ask for a knowledge remediation plan without splitting or re-enabling collections automatically.",
      "selector": "[data-correction-plan=\"create\"][data-target-filter=\"knowledge\"]",
      "no_paid_routes_started": true,
      "provider_secrets_stored": false,
      "raw_prompt_stored": false,
      "raw_response_stored": false,
      "execution_allowed": false
    },
    {
      "id": "approve-or-defer-note",
      "status": "ready",
      "expected": "Approve and defer controls only store local notes; execution remains blocked.",
      "selector": "[data-correction-plan=\"approve\"], [data-correction-plan=\"defer\"]",
      "no_paid_routes_started": true,
      "provider_secrets_stored": false,
      "raw_prompt_stored": false,
      "raw_response_stored": false,
      "execution_allowed": false
    }
  ],
  "next": {
    "task": "D237",
    "label": "Correction remediation execution gates",
    "reason": "After draft plans exist, MMIR needs protected apply gates for specific approved memory/knowledge changes with audit and rollback."
  }
}
