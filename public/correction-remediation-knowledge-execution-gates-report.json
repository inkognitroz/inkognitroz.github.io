{
  "title": "Correction Remediation Knowledge Execution Gates",
  "task": "D243",
  "status": "beta",
  "backend_commit": "54adcaa",
  "principle": "Knowledge source mutation must be backend-only, metadata-only, owner-scoped and preview-confirmed before it changes source state.",
  "public_repo_rule": "GitHub Pages may request previews and send explicit confirmation to a protected backend. It never receives document text, stores provider secrets, starts paid routes or mutates knowledge directly.",
  "backend_route": {
    "method": "POST",
    "path": "/context/corrections/remediation-knowledge-executions/apply",
    "auth": "protected-backend-auth",
    "status": "beta",
    "responses": ["context.correction_knowledge_execution_preview", "context.correction_knowledge_execution"],
    "purpose": "Preview and execute supported knowledge source status and collection metadata updates through backend-only source mutation gates."
  },
  "frontend_module": "./apps/mimir-chat-portal/context-correction-sync.js",
  "local_storage": {
    "knowledge_source_state": "mimir-context-correction-knowledge-source-model-v1:{workspace}",
    "knowledge_execution_state": "mimir-context-correction-knowledge-execution-v1:{workspace}",
    "metadata_only": true
  },
  "ui_contract": {
    "panel": ".context-correction-knowledge-execution-status",
    "checks": ".context-correction-knowledge-execution-checks",
    "results": ".context-correction-knowledge-execution-results",
    "preview_selector": "[data-correction-knowledge-execution=\"preview\"]",
    "execute_selector": "[data-correction-knowledge-execution=\"execute\"]",
    "auto_preview": "recordKnowledgeSourceModel automatically calls previewKnowledgeExecution when the backend returns a recorded source model"
  },
  "execution_policy": {
    "preview_required": true,
    "confirm_required": true,
    "execute_source_mutation_required": true,
    "backend_only_execution": true,
    "knowledge_execution_supported": true,
    "source_mutation_allowed": true,
    "destructive_execution_allowed": false,
    "automatic_mutation_allowed": false,
    "public_frontend_authority": false,
    "no_paid_routes_started": true,
    "raw_prompt_stored": false,
    "raw_response_stored": false,
    "document_text_stored": false,
    "provider_secrets_stored": false
  },
  "supported_execution": {
    "kind": "knowledge-source-metadata-update",
    "mutates": ["knowledge.source_status", "knowledge.collection_membership"],
    "requires": ["recorded knowledge source model", "matching execution preview id", "confirm:true", "execute_source_mutation:true"],
    "captures": ["source_id", "before status", "before collection", "after status", "after collection", "rollback metadata"],
    "raw_text_included": false
  },
  "rollback_metadata": {
    "captured": true,
    "raw_text_included": false,
    "next_gate": "D244 knowledge remediation rollback gates"
  },
  "checks": [
    "source-model",
    "owner-scope",
    "backend-only",
    "metadata-only",
    "rollback-before-after"
  ],
  "scenarios": [
    {
      "id": "auto-preview-after-source-model",
      "status": "ready",
      "expected": "A recorded knowledge source model automatically requests a knowledge execution preview.",
      "selector": "recordKnowledgeSourceModel -> previewKnowledgeExecution",
      "backend_only_execution": true,
      "source_mutation_executed": false
    },
    {
      "id": "execute-metadata-repair",
      "status": "ready",
      "expected": "Owners can apply supported source status and collection metadata updates only after preview confirmation.",
      "selector": "[data-correction-knowledge-execution=\"execute\"]",
      "source_mutation_allowed": true,
      "public_frontend_authority": false
    },
    {
      "id": "capture-rollback-metadata",
      "status": "ready",
      "expected": "Execution receipts include before/after public-safe metadata for a later rollback gate.",
      "rollback_metadata_captured": true,
      "raw_text_included": false
    },
    {
      "id": "no-document-text-or-spend",
      "status": "ready",
      "expected": "Knowledge execution receipts expose metadata only and never document text, provider secrets or paid route execution.",
      "raw_prompt_stored": false,
      "raw_response_stored": false,
      "document_text_stored": false,
      "provider_secrets_stored": false,
      "no_paid_routes_started": true
    }
  ],
  "next": {
    "task": "D244",
    "label": "Knowledge remediation rollback gates",
    "reason": "Knowledge source metadata can now be changed through protected gates. The next slice should apply rollback from captured before/after source metadata."
  }
}
