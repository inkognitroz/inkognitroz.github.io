{
  "title": "Autopilot Source-Mutation Handoff Gates",
  "task": "D246",
  "status": "beta",
  "updated_at": "2026-05-24T05:45:00.000Z",
  "backend_repo": "mimir-backend-template",
  "backend_commit": "6c83644",
  "public_repo_rule": "Public GitHub Pages stores only resumable handoff metadata; source mutation remains explicit, protected-backend-only and never carries raw prompts, document text or provider secrets.",
  "backend_route": {
    "method": "POST",
    "path": "/context/corrections/remediation-autopilot/handoff",
    "auth": "protected-backend-auth",
    "status": "beta",
    "purpose": "Prepare the next source-mutation confirmation route, preview ID and safe confirmation body after autopilot without executing mutation."
  },
  "local_storage": {
    "handoff_state": "mimir-context-correction-autopilot-handoff-v1:{workspace}",
    "stores_raw_prompt": false,
    "stores_raw_response": false,
    "stores_document_text": false,
    "stores_provider_secrets": false,
    "stores_paid_route_credentials": false
  },
  "ui_contract": {
    "panel": ".context-correction-handoff-status",
    "prepare_selector": "[data-correction-handoff=\"prepare\"]",
    "event": "mmir-context-correction-handoff-updated",
    "memory_execution_state": "mimir-context-correction-remediation-execution-v1:{workspace}",
    "knowledge_execution_state": "mimir-context-correction-knowledge-execution-v1:{workspace}"
  },
  "handoff_policy": {
    "preview_required": true,
    "confirm_required": true,
    "backend_only_execution": true,
    "source_mutation_allowed": false,
    "source_mutation_executed": false,
    "automatic_mutation_allowed": false,
    "public_frontend_authority": false,
    "document_text_stored": false,
    "provider_secrets_stored": false,
    "no_paid_routes_started": true
  },
  "handoff_targets": [
    {
      "target": "memory",
      "route": "/context/corrections/remediation-executions/apply",
      "confirmation_body_fields": [
        "workspace_id",
        "commit_id",
        "execution_preview_id",
        "confirm",
        "execute_source_mutation"
      ],
      "rollback_route": "/context/corrections/remediation-rollbacks/apply"
    },
    {
      "target": "knowledge",
      "route": "/context/corrections/remediation-knowledge-executions/apply",
      "confirmation_body_fields": [
        "workspace_id",
        "model_id",
        "execution_preview_id",
        "confirm",
        "execute_source_mutation"
      ],
      "rollback_route": "/context/corrections/remediation-knowledge-rollbacks/apply"
    }
  ],
  "scenarios": [
    {
      "id": "auto-handoff-after-safe-run",
      "status": "ready",
      "expected": "A completed safe autopilot run automatically asks the backend for a source-mutation handoff.",
      "selector": ".context-correction-handoff-status",
      "source_mutation_executed": false,
      "no_paid_routes_started": true
    },
    {
      "id": "memory-handoff-resume",
      "status": "ready",
      "expected": "Memory handoff writes the execution preview into the existing memory execution state so explicit confirmation can resume.",
      "selector": "[data-correction-execution=\"execute\"]",
      "public_frontend_authority": false,
      "source_mutation_executed": false
    },
    {
      "id": "knowledge-handoff-resume",
      "status": "ready",
      "expected": "Knowledge handoff writes the knowledge execution preview into the existing knowledge execution state without document text.",
      "selector": "[data-correction-knowledge-execution=\"execute\"]",
      "document_text_stored": false,
      "source_mutation_executed": false
    },
    {
      "id": "no-secret-or-spend",
      "status": "ready",
      "expected": "The handoff flow stores no provider credentials, raw chat text or document text and starts no paid route.",
      "selector": "mmir-api-routes.json",
      "provider_secrets_stored": false,
      "document_text_stored": false,
      "no_paid_routes_started": true
    }
  ],
  "next": {
    "task": "D247",
    "label": "autopilot rollback readiness cards",
    "why": "After source-mutation handoff can resume cleanly, users need a simple rollback readiness view before and after explicit source changes."
  }
}
