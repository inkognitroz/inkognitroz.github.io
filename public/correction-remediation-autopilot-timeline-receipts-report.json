{
  "title": "Autopilot Timeline Post-Action Receipts",
  "task": "D250",
  "status": "beta",
  "updated_at": "2026-05-24T04:25:00.000Z",
  "public_repo_rule": "Timeline receipts are browser-local metadata only; source mutation, rollback and readiness checks remain protected backend actions.",
  "local_storage": {
    "receipt_state": "mimir-context-correction-autopilot-trust-receipt-v1:{workspace}",
    "stores_raw_prompt": false,
    "stores_raw_response": false,
    "stores_document_text": false,
    "stores_provider_secrets": false,
    "stores_paid_route_credentials": false
  },
  "ui_contract": {
    "panel": ".context-correction-trust-receipt",
    "event": "mmir-context-correction-trust-receipt-updated",
    "export": "readTrustReceiptState",
    "actions": ["confirm-source", "refresh-readiness", "apply-rollback"]
  },
  "receipt_policy": {
    "browser_local_metadata_only": true,
    "protected_backend_route_required": true,
    "explicit_user_action_required": true,
    "public_frontend_authority": false,
    "automatic_mutation_allowed": false,
    "provider_secrets_stored": false,
    "raw_prompt_stored": false,
    "raw_response_stored": false,
    "document_text_stored": false,
    "no_paid_routes_started": true
  },
  "routes": [
    {
      "action": "confirm-source",
      "memory_route": "/context/corrections/remediation-executions/apply",
      "knowledge_route": "/context/corrections/remediation-knowledge-executions/apply",
      "next_action": "refresh rollback"
    },
    {
      "action": "refresh-readiness",
      "route": "/context/corrections/remediation-autopilot/rollback-readiness",
      "next_action": "review undo path"
    },
    {
      "action": "apply-rollback",
      "memory_route": "/context/corrections/remediation-rollbacks/apply",
      "knowledge_route": "/context/corrections/remediation-knowledge-rollbacks/apply",
      "next_action": "review restored state"
    }
  ],
  "scenarios": [
    {
      "id": "confirm-source-receipt",
      "status": "ready",
      "expected": "Confirm source writes a running receipt, awaits the protected backend execution gate and records result status plus next action.",
      "selector": "[data-correction-trust-timeline=\"confirm-source\"]",
      "automatic_mutation_allowed": false
    },
    {
      "id": "refresh-readiness-receipt",
      "status": "ready",
      "expected": "Refresh rollback writes a route-specific readiness receipt without executing mutation or rollback.",
      "selector": "[data-correction-trust-timeline=\"refresh-readiness\"]",
      "source_mutation_executed": false
    },
    {
      "id": "apply-rollback-receipt",
      "status": "ready",
      "expected": "Apply undo writes a receipt for the protected rollback gate and records the restored-state next action.",
      "selector": "[data-correction-trust-timeline=\"apply-rollback\"]",
      "backend_only_rollback": true
    },
    {
      "id": "no-secret-or-spend",
      "status": "ready",
      "expected": "Receipts store only action, route, result status and next action; no raw data, provider credentials or paid routes.",
      "selector": ".context-correction-trust-receipt",
      "provider_secrets_stored": false,
      "document_text_stored": false,
      "no_paid_routes_started": true
    }
  ],
  "next": {
    "task": "D251",
    "label": "autopilot timeline receipt browser QA",
    "why": "After receipts exist, add deterministic fixture coverage for running, ready and error receipt states on desktop and mobile."
  }
}
