{
  "title": "Protected Correction Review Queue",
  "task": "D235",
  "status": "beta",
  "backend_commit": "8b61243",
  "principle": "Correction review belongs behind protected auth. The public UI can request and render safe metadata, but it is not the source of authority.",
  "public_repo_rule": "GitHub Pages may store local UI state and backend-returned correction metadata only; it must never store raw prompts, raw responses, transcripts, provider keys, session tokens or document text.",
  "backend_route": {
    "method": "GET",
    "path": "/context/corrections/review",
    "auth": "protected-backend-auth",
    "status": "beta",
    "purpose": "Return owner-scoped prioritized correction review items with filters, summaries and safe next actions."
  },
  "frontend_module": "./apps/mimir-chat-portal/context-correction-sync.js",
  "local_storage": {
    "source": "mimir-context-corrections-v1:{workspace}",
    "sync_state": "mimir-context-correction-sync-v1:{workspace}",
    "review_state": "mimir-context-correction-review-v1:{workspace}",
    "metadata_only": true
  },
  "filters": [
    {
      "id": "all",
      "selector": "[data-correction-review=\"load\"][data-target-filter=\"all\"]",
      "query": "workspace_id, limit"
    },
    {
      "id": "memory",
      "selector": "[data-correction-review=\"load\"][data-target-filter=\"memory\"]",
      "query": "workspace_id, target=memory, limit"
    },
    {
      "id": "knowledge",
      "selector": "[data-correction-review=\"load\"][data-target-filter=\"knowledge\"]",
      "query": "workspace_id, target=knowledge, limit"
    },
    {
      "id": "include-undone",
      "selector": "[data-correction-review=\"load\"][data-include-undone=\"true\"]",
      "query": "workspace_id, include_undone=true, limit"
    }
  ],
  "ui_contract": {
    "panel": ".context-correction-review-panel",
    "summary": ".context-correction-review-summary",
    "list": ".context-correction-review-list",
    "open_target_action": "[data-correction-review=\"open\"]"
  },
  "safe_fields": [
    "id",
    "workspace_id",
    "target",
    "action",
    "message_id",
    "answer_message_id",
    "correction_id",
    "model",
    "source_ids",
    "source_count",
    "undo",
    "suggestions",
    "review_status",
    "review_priority",
    "review_reason",
    "next_actions",
    "created_at",
    "updated_at",
    "undone_at"
  ],
  "blocked_fields": [
    "prompt",
    "raw_prompt",
    "response",
    "raw_response",
    "messages",
    "transcript",
    "api_key",
    "access_token",
    "refresh_token",
    "secret",
    "document_text"
  ],
  "scenarios": [
    {
      "id": "load-review-queue",
      "status": "ready",
      "expected": "Users can load the protected review queue through the active backend profile.",
      "route": "GET /context/corrections/review",
      "no_paid_routes_started": true,
      "provider_secrets_stored": false,
      "raw_prompt_stored": false,
      "raw_response_stored": false
    },
    {
      "id": "filter-memory",
      "status": "ready",
      "expected": "Users can filter review items to memory corrections.",
      "route": "GET /context/corrections/review?target=memory",
      "no_paid_routes_started": true,
      "provider_secrets_stored": false,
      "raw_prompt_stored": false,
      "raw_response_stored": false
    },
    {
      "id": "filter-knowledge",
      "status": "ready",
      "expected": "Users can filter review items to knowledge corrections.",
      "route": "GET /context/corrections/review?target=knowledge",
      "no_paid_routes_started": true,
      "provider_secrets_stored": false,
      "raw_prompt_stored": false,
      "raw_response_stored": false
    },
    {
      "id": "open-target",
      "status": "ready",
      "expected": "Safe next actions open Memory, Knowledge or Progress panels without executing hidden remediation.",
      "route": "browser-local panel handoff",
      "no_paid_routes_started": true,
      "provider_secrets_stored": false,
      "raw_prompt_stored": false,
      "raw_response_stored": false
    }
  ],
  "next": {
    "task": "D236",
    "label": "Correction remediation plan handoff",
    "reason": "After owners can inspect review items, MMIR should generate explicit repair plans for memory scope, knowledge collection split and undo/remediation actions."
  }
}
