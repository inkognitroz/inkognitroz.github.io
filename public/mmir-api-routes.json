    { "path": "/versions", "owner": "managed-api", "auth": "protected-backend-auth", "status": "beta", "kind": "dynamic-fragment", "purpose": "Dataset/prompt version dynamic route fragment." },
    { "path": "/waitlist", "owner": "managed-api", "auth": "protected-backend-auth", "status": "planned", "purpose": "Beta/waitlist capture when protected backend is available." },
    { "path": "/web/search", "owner": "managed-api", "auth": "protected-backend-auth", "status": "planned", "purpose": "Protected web search route with explicit user consent." },
    { "path": "/web/search/providers", "owner": "managed-api", "auth": "protected-backend-auth", "status": "planned", "purpose": "Protected web search provider capabilities." },
    { "path": "/workflows", "owner": "managed-api", "auth": "protected-backend-auth", "status": "beta", "purpose": "Protected workflow registry root." },
    { "path": "/workflows/", "owner": "managed-api", "auth": "protected-backend-auth", "status": "beta", "kind": "dynamic-fragment", "purpose": "Workflow dynamic route fragment." }
  ]
