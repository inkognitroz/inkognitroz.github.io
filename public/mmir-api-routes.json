    { "path": "/runs", "owner": "managed-api", "auth": "protected-backend-auth", "status": "beta", "kind": "dynamic-fragment", "purpose": "Workflow run dynamic route fragment." },
    { "path": "/shares", "owner": "managed-api", "auth": "protected-backend-auth", "status": "beta", "purpose": "Protected share registry root." },
