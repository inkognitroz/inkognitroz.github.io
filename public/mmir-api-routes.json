    { "path": "/status", "owner": "local-node", "auth": "public-safe", "status": "live", "purpose": "Node/runtime status and capability inventory." },
    { "path": "/tools", "owner": "managed-api", "auth": "protected-backend-auth", "status": "planned", "purpose": "Protected tool capability list." },
    { "path": "/tools/execute", "owner": "managed-api", "auth": "protected-backend-auth", "status": "planned", "purpose": "Protected tool execution route." },
    { "path": "/training/jobs", "owner": "managed-api", "auth": "protected-backend-auth", "status": "planned", "purpose": "Training job planning without automatic paid compute." },
    { "path": "/training/jobs/", "owner": "managed-api", "auth": "protected-backend-auth", "status": "planned", "kind": "dynamic-fragment", "purpose": "Training job dynamic route fragment." },
    { "path": "/tunnels/status", "owner": "local-node", "auth": "paired-local-token", "status": "beta", "purpose": "Safe tunnel status without secrets." },
