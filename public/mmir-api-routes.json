    { "path": "/knowledge/search", "owner": "managed-api", "auth": "protected-backend-auth", "status": "beta", "purpose": "Protected knowledge search." },
    { "path": "/memory", "owner": "managed-api", "auth": "protected-backend-auth", "status": "beta", "purpose": "Protected workspace memory root." },
