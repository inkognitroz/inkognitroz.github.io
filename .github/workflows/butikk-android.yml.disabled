# DEAKTIVERT MED VILJE (.disabled-suffiks): billing containment på GitHub
# Actions (control#944) — ALLE fil-workflows er stoppet flåtebredt.
# Aktivering (eier-beslutning): fjern `.disabled` fra filnavnet NÅR
# Actions-stoppen er opphevet, og legg inn secrets (se owner-checklist.md):
#   ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD,
#   ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
# Workflowen kjører på self-hosted runner (null-kost CI, jf. 14.07-oppsettet).
# Uten signerings-secrets bygges usignert .aab (kan lastes opp hvis Play App
# Signing brukes med upload-nøkkel senere — men signert anbefales).

name: butikk-android

on:
  workflow_dispatch: {}
  push:
    branches: [main]
    paths:
      - 'apps/store-wrapper/**'
      - '.github/workflows/butikk-android.yml'

concurrency:
  group: butikk-android
  cancel-in-progress: true

jobs:
  build-aab:
    # Self-hosted for null kost. Bytt til ubuntu-latest KUN hvis
    # Actions-billing er avklart.
    runs-on: [self-hosted]
    timeout-minutes: 45
    defaults:
      run:
        working-directory: apps/store-wrapper
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Android SDK
        uses: android-actions/setup-android@v3

      - name: Install deps
        run: npm ci

      - name: Capacitor sync
        run: npx cap sync android

      - name: Restore keystore (hvis secrets finnes)
        env:
          KEYSTORE_B64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
        run: |
          if [ -n "$KEYSTORE_B64" ]; then
            echo "$KEYSTORE_B64" | base64 -d > android/app/upload.keystore
            echo "Keystore gjenopprettet"
          else
            echo "Ingen keystore-secret — bygger usignert"
          fi

      - name: Build release bundle (.aab)
        working-directory: apps/store-wrapper/android
        env:
          KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: ./gradlew bundleRelease --no-daemon

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: supergeni-release-aab
          path: apps/store-wrapper/android/app/build/outputs/bundle/release/*.aab
          retention-days: 14
